{
  "@context": {
    "cb": "https://urbangametheory.xyz/vocabulary/1/#",
    "schema": "https://schema.org/",
    "geo": "http://www.opengis.net/ont/geosparql#",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "cb:Design",
      "@type": "rdfs:Class",
      "rdfs:label": "Published design",
      "rdfs:comment": "One authored change (a road, a park, a parcel layout, an urban rule, a building), identified by the CID of its canonical content. Its existence does not assert construction, ownership or legal approval.",
      "rdfs:subClassOf": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:Agreement",
      "@type": "rdfs:Class",
      "rdfs:label": "Published agreement",
      "rdfs:comment": "A set of designs plus a decision rule, with optional allocations and money, identified by the CID of its canonical content, which names its designs by their CIDs. Its existence does not assert consent, execution or legal approval.",
      "rdfs:subClassOf": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:DesignSite",
      "@type": "rdfs:Class",
      "rdfs:label": "Design site",
      "rdfs:comment": "The geographic extent authored as the design site. It is not a legal cadastral parcel or an assertion of a constructed project.",
      "rdfs:subClassOf": [
        {
          "@id": "geo:Feature"
        }
      ]
    },
    {
      "@id": "cb:CadastreReference",
      "@type": "rdfs:Class",
      "rdfs:label": "Declared cadastral reference",
      "rdfs:comment": "A cadastral identifier an agreement names as its input land. This node is scoped to the agreement; it does not establish cross-provider parcel identity.",
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:cid",
      "@type": "rdf:Property",
      "rdfs:label": "Content identifier",
      "rdfs:comment": "The CIDv1 (raw codec, sha2-256, base32) of the record's canonical bytes: its identity. Changed content is a different record.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:authorLabel",
      "@type": "rdf:Property",
      "rdfs:label": "Author label",
      "rdfs:comment": "A stored author attribution string; not a verified person, organization or signing authority.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:declaredGoal",
      "@type": "rdf:Property",
      "rdfs:label": "Declared design goal",
      "rdfs:comment": "The exact design-goal string carried by the design, including unclassified values.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:designGoal",
      "@type": "rdf:Property",
      "rdfs:label": "Design-goal concept",
      "rdfs:comment": "An exact match to the current design-goal concept scheme; not a physical-object classification.",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "cb:site",
      "@type": "rdf:Property",
      "rdfs:label": "Authored site",
      "rdfs:comment": "The geographic site declared by this design.",
      "rdfs:range": {
        "@id": "cb:DesignSite"
      }
    },
    {
      "@id": "cb:designs",
      "@type": "rdf:Property",
      "rdfs:label": "Designs",
      "rdfs:comment": "An RDF list of the designs the agreement includes, by CID, in authored order.",
      "rdfs:range": {
        "@id": "rdf:List"
      }
    },
    {
      "@id": "cb:decisionRule",
      "@type": "rdf:Property",
      "rdfs:label": "Decision rule",
      "rdfs:comment": "Who decides the agreement and whether the decision binds, as its content states it.",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "cb:agreementDeadline",
      "@type": "rdf:Property",
      "rdfs:label": "Agreement deadline",
      "rdfs:comment": "The deadline carried by the agreement. It does not promise a settlement or construction time.",
      "rdfs:range": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "cb:cadastreReference",
      "@type": "rdf:Property",
      "rdfs:label": "Declared cadastral reference",
      "rdfs:comment": "An agreement-scoped declaration of a cadastral identifier of its input land.",
      "rdfs:range": {
        "@id": "cb:CadastreReference"
      }
    },
    {
      "@id": "cb:declaredIdentifier",
      "@type": "rdf:Property",
      "rdfs:label": "Declared identifier",
      "rdfs:comment": "The exact identifier string in a scoped reference.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:DesignGoals",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "DesignGoals"
    },
    {
      "@id": "cb:DecisionRules",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "DecisionRules"
    },
    {
      "@id": "cb:goal-as-is",
      "@type": "skos:Concept",
      "skos:prefLabel": "Keep as is",
      "skos:definition": "Retain the selected ground or existing design while changing ownership or proposal terms.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-square",
      "@type": "skos:Concept",
      "skos:prefLabel": "Square",
      "skos:definition": "An authored square or paved open-space design.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-park",
      "@type": "skos:Concept",
      "skos:prefLabel": "Park",
      "skos:definition": "An authored park or landscaped open-space design.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-lake",
      "@type": "skos:Concept",
      "skos:prefLabel": "Lake",
      "skos:definition": "An authored water-body design.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-station",
      "@type": "skos:Concept",
      "skos:prefLabel": "Station",
      "skos:definition": "An authored transit-station structure design and its parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-single",
      "@type": "skos:Concept",
      "skos:prefLabel": "Freeform building",
      "skos:definition": "Authored freeform building geometry; the tool name does not require exactly one building.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-buildings",
      "@type": "skos:Concept",
      "skos:prefLabel": "Block building rule",
      "skos:definition": "A parcel-bound block building design and its authored rule parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-row",
      "@type": "skos:Concept",
      "skos:prefLabel": "Row building rule",
      "skos:definition": "A parcel-bound row building design and its authored rule parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-parcelBased",
      "@type": "skos:Concept",
      "skos:prefLabel": "Detached building rule",
      "skos:definition": "Buildings generated separately on selected parcels from authored detached-building rules.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-urban-rule",
      "@type": "skos:Concept",
      "skos:prefLabel": "Urban rule",
      "skos:definition": "An authored urban-rule proposal handled by the generic record editor.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-road-track",
      "@type": "skos:Concept",
      "skos:prefLabel": "Road or track",
      "skos:definition": "An authored corridor design with route, profile and segment parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-parcel-layout",
      "@type": "skos:Concept",
      "skos:prefLabel": "Parcel layout",
      "skos:definition": "Authored parcel borders over a pool: the pool outline and the output plots, geometry only.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-ownership-transfer",
      "@type": "skos:Concept",
      "skos:prefLabel": "Ownership transfer",
      "skos:definition": "Proposed changes to rights or recipients; transfer direction is a separate term.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:rule-owner-deal",
      "@type": "skos:Concept",
      "skos:prefLabel": "Owner deal",
      "skos:definition": "The owners of the input land decide, and the decision binds: the agreement may execute once its rule is satisfied. The classification does not prove title or consent.",
      "skos:inScheme": {
        "@id": "cb:DecisionRules"
      }
    },
    {
      "@id": "cb:rule-owner-vote",
      "@type": "skos:Concept",
      "skos:prefLabel": "Owner vote",
      "skos:definition": "Nonbinding vote of the owners of the input land; no execution.",
      "skos:inScheme": {
        "@id": "cb:DecisionRules"
      }
    },
    {
      "@id": "cb:rule-community-vote",
      "@type": "skos:Concept",
      "skos:prefLabel": "Community vote",
      "skos:definition": "Nonbinding community vote; no execution.",
      "skos:inScheme": {
        "@id": "cb:DecisionRules"
      }
    }
  ]
}
