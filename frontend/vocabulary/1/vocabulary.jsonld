{
  "@context": {
    "cb": "https://urbangametheory.xyz/vocabulary/1/#",
    "schema": "https://schema.org/",
    "geo": "http://www.opengis.net/ont/geosparql#",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "cb:Proposal",
      "@type": "rdfs:Class",
      "rdfs:label": "Published proposal",
      "rdfs:comment": "An authored proposal record in a publication store. Its existence does not assert construction, ownership or legal approval.",
      "rdfs:subClassOf": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:NamedPlan",
      "@type": "rdfs:Class",
      "rdfs:label": "Named plan",
      "rdfs:comment": "An immutable named commitment to an ordered set of proposal members and their saved content hashes.",
      "rdfs:subClassOf": [
        {
          "@id": "schema:Collection"
        },
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:PlanMembership",
      "@type": "rdfs:Class",
      "rdfs:label": "Plan membership commitment",
      "rdfs:comment": "A position in a named plan, identifying a published proposal and the member content hash saved when the plan was named.",
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:ProposalSite",
      "@type": "rdfs:Class",
      "rdfs:label": "Proposal site",
      "rdfs:comment": "The geographic extent authored as the proposal site. It is not a legal cadastral parcel or an assertion of a constructed project.",
      "rdfs:subClassOf": [
        {
          "@id": "geo:Feature"
        }
      ]
    },
    {
      "@id": "cb:CadastreReference",
      "@type": "rdfs:Class",
      "rdfs:label": "Declared cadastral reference",
      "rdfs:comment": "A cadastral identifier declared by this proposal. This node is scoped to the proposal; it does not establish cross-provider parcel identity.",
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:ChainReference",
      "@type": "rdfs:Class",
      "rdfs:label": "Declared chain reference",
      "rdfs:comment": "A complete chain family, network, contract or program, and token or account location declared by the server-owned attachment. This alone is not verified execution evidence.",
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "cb:proposalRowId",
      "@type": "rdf:Property",
      "rdfs:label": "Publication row ID",
      "rdfs:comment": "Decimal database row key within the canonical publication API.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:authoredProposalId",
      "@type": "rdf:Property",
      "rdfs:label": "Authored proposal ID",
      "rdfs:comment": "Authored identifier carried by the published record, separate from a database row key or chain account.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:authorLabel",
      "@type": "rdf:Property",
      "rdfs:label": "Author label",
      "rdfs:comment": "A stored author attribution string; not a verified person, organization or signing authority.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:declaredGoal",
      "@type": "rdf:Property",
      "rdfs:label": "Declared design goal",
      "rdfs:comment": "The exact design-goal string carried by the record, including unclassified values.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:designGoal",
      "@type": "rdf:Property",
      "rdfs:label": "Design-goal concept",
      "rdfs:comment": "An exact match to the current design-goal concept scheme; not a physical-object classification.",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "cb:decisionKind",
      "@type": "rdf:Property",
      "rdfs:label": "Decision kind",
      "rdfs:comment": "The decision kind interpreted by the current application contract. A missing historical kind is interpreted as owner-deal.",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "cb:recordedLifecycle",
      "@type": "rdf:Property",
      "rdfs:label": "Recorded lifecycle",
      "rdfs:comment": "The API record lifecycle, including its Active-only deadline rule. This is not an independently observed chain or construction state.",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "cb:proposalDeadline",
      "@type": "rdf:Property",
      "rdfs:label": "Proposal deadline",
      "rdfs:comment": "The deadline carried by the proposal. It does not promise a settlement or construction time.",
      "rdfs:range": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "cb:site",
      "@type": "rdf:Property",
      "rdfs:label": "Authored site",
      "rdfs:comment": "The geographic site declared by this proposal.",
      "rdfs:range": {
        "@id": "cb:ProposalSite"
      }
    },
    {
      "@id": "cb:cadastreReference",
      "@type": "rdf:Property",
      "rdfs:label": "Declared cadastral reference",
      "rdfs:comment": "A proposal-scoped declaration of a cadastral identifier.",
      "rdfs:range": {
        "@id": "cb:CadastreReference"
      }
    },
    {
      "@id": "cb:declaredIdentifier",
      "@type": "rdf:Property",
      "rdfs:label": "Declared identifier",
      "rdfs:comment": "The exact identifier string in a scoped reference.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:declaredChainReference",
      "@type": "rdf:Property",
      "rdfs:label": "Declared chain location",
      "rdfs:comment": "A complete location from the server-owned chain attachment; not proof of current chain state.",
      "rdfs:range": {
        "@id": "cb:ChainReference"
      }
    },
    {
      "@id": "cb:chainType",
      "@type": "rdf:Property",
      "rdfs:label": "Chain family",
      "rdfs:comment": "Declared blockchain family, such as evm or solana.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:chainId",
      "@type": "rdf:Property",
      "rdfs:label": "Chain network",
      "rdfs:comment": "Declared network identifier in the chain family.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:contract",
      "@type": "rdf:Property",
      "rdfs:label": "Contract or program",
      "rdfs:comment": "Declared contract or program identifier. Case is retained.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:tokenId",
      "@type": "rdf:Property",
      "rdfs:label": "Token or account",
      "rdfs:comment": "Declared proposal token or account identifier. Case is retained.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:offeredConsideration",
      "@type": "rdf:Property",
      "rdfs:label": "Offered consideration",
      "rdfs:comment": "An explicit authored offer amount and currency. It is not a balance, paid amount or escrow observation.",
      "rdfs:range": {
        "@id": "schema:MonetaryAmount"
      }
    },
    {
      "@id": "cb:budget",
      "@type": "rdf:Property",
      "rdfs:label": "Authored budget",
      "rdfs:comment": "An explicit authored budget amount and currency, distinct from offered consideration.",
      "rdfs:range": {
        "@id": "schema:MonetaryAmount"
      }
    },
    {
      "@id": "cb:memberships",
      "@type": "rdf:Property",
      "rdfs:label": "Ordered memberships",
      "rdfs:comment": "An RDF list of the plan membership commitments, preserving their saved order.",
      "rdfs:range": {
        "@id": "rdf:List"
      }
    },
    {
      "@id": "cb:member",
      "@type": "rdf:Property",
      "rdfs:label": "Member proposal",
      "rdfs:comment": "The published proposal record named by a membership commitment.",
      "rdfs:range": {
        "@id": "cb:Proposal"
      }
    },
    {
      "@id": "cb:committedMemberHash",
      "@type": "rdf:Property",
      "rdfs:label": "Committed member hash",
      "rdfs:comment": "Saved SHA-256 memberContent digest, under the application commitment contract; not a digest of this JSON-LD document.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:currentMemberHash",
      "@type": "rdf:Property",
      "rdfs:label": "Current member hash",
      "rdfs:comment": "The current memberContent digest calculated during this read, when the member exists.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:memberChanged",
      "@type": "rdf:Property",
      "rdfs:label": "Member changed",
      "rdfs:comment": "True when the current member is missing, has invalid commitment content, or its memberContent digest differs from the saved commitment.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "cb:memberMissing",
      "@type": "rdf:Property",
      "rdfs:label": "Member missing",
      "rdfs:comment": "True when the referenced member could not be found during this read.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "cb:memberInvalid",
      "@type": "rdf:Property",
      "rdfs:label": "Member content invalid",
      "rdfs:comment": "True when the current member exists but cannot be hashed under the current readjustment commitment contract.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "cb:planHash",
      "@type": "rdf:Property",
      "rdfs:label": "Saved plan hash",
      "rdfs:comment": "Saved aggregate commitment over ordered authored proposal identifiers and member hashes. It does not identify every field in this export.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cb:supersedes",
      "@type": "rdf:Property",
      "rdfs:label": "Supersedes named plan",
      "rdfs:comment": "An explicit link to the previous named plan revision.",
      "rdfs:range": {
        "@id": "cb:NamedPlan"
      }
    },
    {
      "@id": "cb:supersededBy",
      "@type": "rdf:Property",
      "rdfs:label": "Superseded by named plan",
      "rdfs:comment": "A named plan that explicitly declares this plan as its previous revision.",
      "rdfs:range": {
        "@id": "cb:NamedPlan"
      }
    },
    {
      "@id": "cb:DesignGoals",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "DesignGoals"
    },
    {
      "@id": "cb:DecisionKinds",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "DecisionKinds"
    },
    {
      "@id": "cb:RecordLifecycles",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "RecordLifecycles"
    },
    {
      "@id": "cb:goal-as-is",
      "@type": "skos:Concept",
      "skos:prefLabel": "Keep as is",
      "skos:definition": "Retain the selected ground or existing design while changing ownership or proposal terms.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-square",
      "@type": "skos:Concept",
      "skos:prefLabel": "Square",
      "skos:definition": "An authored square or paved open-space design.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-park",
      "@type": "skos:Concept",
      "skos:prefLabel": "Park",
      "skos:definition": "An authored park or landscaped open-space design.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-lake",
      "@type": "skos:Concept",
      "skos:prefLabel": "Lake",
      "skos:definition": "An authored water-body design.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-station",
      "@type": "skos:Concept",
      "skos:prefLabel": "Station",
      "skos:definition": "An authored transit-station structure design and its parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-single",
      "@type": "skos:Concept",
      "skos:prefLabel": "Freeform building",
      "skos:definition": "Authored freeform building geometry; the tool name does not require exactly one building.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-buildings",
      "@type": "skos:Concept",
      "skos:prefLabel": "Block building rule",
      "skos:definition": "A parcel-bound block building design and its authored rule parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-row",
      "@type": "skos:Concept",
      "skos:prefLabel": "Row building rule",
      "skos:definition": "A parcel-bound row building design and its authored rule parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-parcelBased",
      "@type": "skos:Concept",
      "skos:prefLabel": "Detached building rule",
      "skos:definition": "Buildings generated separately on selected parcels from authored detached-building rules.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-urban-rule",
      "@type": "skos:Concept",
      "skos:prefLabel": "Urban rule",
      "skos:definition": "An authored urban-rule proposal handled by the generic record editor.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-road-track",
      "@type": "skos:Concept",
      "skos:prefLabel": "Road or track",
      "skos:definition": "An authored corridor design with route, profile and segment parameters.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-reparcellization",
      "@type": "skos:Concept",
      "skos:prefLabel": "Land readjustment",
      "skos:definition": "An authored subdivision and allocation arrangement over declared cadastral land.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:goal-ownership-transfer",
      "@type": "skos:Concept",
      "skos:prefLabel": "Ownership transfer",
      "skos:definition": "Proposed changes to rights or recipients; transfer direction is a separate term.",
      "skos:inScheme": {
        "@id": "cb:DesignGoals"
      }
    },
    {
      "@id": "cb:kind-owner-deal",
      "@type": "skos:Concept",
      "skos:prefLabel": "Owner deal",
      "skos:definition": "Binding proposal path, subject to its applicable terms and approvals; the classification does not prove title or consent.",
      "skos:inScheme": {
        "@id": "cb:DecisionKinds"
      }
    },
    {
      "@id": "cb:kind-owner-vote",
      "@type": "skos:Concept",
      "skos:prefLabel": "Owner vote",
      "skos:definition": "Nonbinding vote addressed to the proposal owner electorate; no money or execution.",
      "skos:inScheme": {
        "@id": "cb:DecisionKinds"
      }
    },
    {
      "@id": "cb:kind-community-vote",
      "@type": "skos:Concept",
      "skos:prefLabel": "Community vote",
      "skos:definition": "Nonbinding community vote; no money or execution.",
      "skos:inScheme": {
        "@id": "cb:DecisionKinds"
      }
    },
    {
      "@id": "cb:lifecycle-draft",
      "@type": "skos:Concept",
      "skos:prefLabel": "Draft",
      "skos:definition": "Stored draft state.",
      "skos:inScheme": {
        "@id": "cb:RecordLifecycles"
      }
    },
    {
      "@id": "cb:lifecycle-Active",
      "@type": "skos:Concept",
      "skos:prefLabel": "Active",
      "skos:definition": "Stored active state with no elapsed recorded deadline.",
      "skos:inScheme": {
        "@id": "cb:RecordLifecycles"
      }
    },
    {
      "@id": "cb:lifecycle-Executed",
      "@type": "skos:Concept",
      "skos:prefLabel": "Executed",
      "skos:definition": "Stored execution state; physical realization and independent chain proof are separate.",
      "skos:inScheme": {
        "@id": "cb:RecordLifecycles"
      }
    },
    {
      "@id": "cb:lifecycle-Cancelled",
      "@type": "skos:Concept",
      "skos:prefLabel": "Cancelled",
      "skos:definition": "Stored cancellation state.",
      "skos:inScheme": {
        "@id": "cb:RecordLifecycles"
      }
    },
    {
      "@id": "cb:lifecycle-Expired",
      "@type": "skos:Concept",
      "skos:prefLabel": "Expired",
      "skos:definition": "Stored expiry state or an Active record whose recorded deadline elapsed.",
      "skos:inScheme": {
        "@id": "cb:RecordLifecycles"
      }
    },
    {
      "@id": "cb:lifecycle-Unknown",
      "@type": "skos:Concept",
      "skos:prefLabel": "Unknown",
      "skos:definition": "Missing or unrecognized stored lifecycle; no Active or terminal state is inferred.",
      "skos:inScheme": {
        "@id": "cb:RecordLifecycles"
      }
    }
  ]
}
