{
    "cleanUrls": false,
    "directoryListing": false,
    "rewrites": [
        { "source": "/flights/**", "destination": "/index.html" },
        { "source": "/", "destination": "/index.html" },
        { "source": "/sources", "destination": "/sources.html" },
        { "source": "/feedback", "destination": "/feedback.html" },
        { "source": "/vocabulary", "destination": "/vocabulary/index.html" },
        { "source": "/vocabulary/", "destination": "/vocabulary/index.html" },
        { "source": "/vocabulary/1", "destination": "/vocabulary/1/index.html" },
        { "source": "/vocabulary/1/", "destination": "/vocabulary/1/index.html" },
        { "source": "/proposals/**", "destination": "/index.html" },
        { "source": "/designs", "destination": "/index.html" },
        { "source": "/designs/**", "destination": "/index.html" },
        { "source": "/agreements/**", "destination": "/index.html" },
        { "source": "/plans/**", "destination": "/index.html" },
        { "source": "/proposal/**", "destination": "/index.html" },
        { "source": "/parcel/**", "destination": "/index.html" },
        { "source": "/bets/**", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "**",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, must-revalidate" }
            ]
        }
    ]
}
