{
  "name": "consensus-builder-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E tests for consensus-builder frontend",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:core": "playwright test --grep @core",
    "test:features": "playwright test --grep @features",
    "test:controls": "node scripts/run-controls.mjs",
    "report:controls": "node scripts/report-controls.mjs --check",
    "prove:controls": "node scripts/prove-controls.mjs",
    "check:controls": "node --test scripts/control-source.test.mjs scripts/control-report.test.mjs scripts/control-coverage.test.mjs && node scripts/check-control-contract.mjs",
    "report": "playwright show-report",
    "check:features": "node scripts/check-feature-inventory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.5.0"
  }
}
